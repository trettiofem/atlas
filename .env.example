# Optional. Port for the web UI. Defaults to 5182.
# PORT=5182

# Required for agents and the Explain chat, unless OLLAMA_MODEL is set.
CLAUDE_API_KEY=

# Optional. Defaults to claude-haiku-5-5.
# CLAUDE_MODEL=claude-haiku-5-5

# Optional. Run agents on a local Ollama model instead of Claude (Ollama 0.14+, and a model with tool calling,
# e.g. qwen3). With CLAUDE_API_KEY also set, it's the default and the prompt box can switch to Claude.
# OLLAMA_MODEL=qwen3

# Optional. Defaults to http://localhost:11434.
# OLLAMA_HOST=http://localhost:11434
